# .gitattributes for URC-CAD
# Routes all SolidWorks + common CAD/exchange binary files through Git LFS.
# Run `git lfs install` once per machine, then `git lfs track` is already
# handled by the patterns below — just make sure this file is committed.

# --- SolidWorks native files ---
*.SLDPRT filter=lfs diff=lfs merge=lfs -text
*.SLDASM filter=lfs diff=lfs merge=lfs -text
*.SLDDRW filter=lfs diff=lfs merge=lfs -text
*.sldprt filter=lfs diff=lfs merge=lfs -text
*.sldasm filter=lfs diff=lfs merge=lfs -text
*.slddrw filter=lfs diff=lfs merge=lfs -text
*.prtdot filter=lfs diff=lfs merge=lfs -text
*.asmdot filter=lfs diff=lfs merge=lfs -text
*.drwdot filter=lfs diff=lfs merge=lfs -text
*.sldlfp filter=lfs diff=lfs merge=lfs -text

# --- Exchange / neutral CAD formats (COTS parts, exports) ---
*.STEP filter=lfs diff=lfs merge=lfs -text
*.step filter=lfs diff=lfs merge=lfs -text
*.stp  filter=lfs diff=lfs merge=lfs -text
*.STP  filter=lfs diff=lfs merge=lfs -text
*.IGES filter=lfs diff=lfs merge=lfs -text
*.iges filter=lfs diff=lfs merge=lfs -text
*.igs  filter=lfs diff=lfs merge=lfs -text
*.x_t  filter=lfs diff=lfs merge=lfs -text
*.x_b  filter=lfs diff=lfs merge=lfs -text

# --- Mesh / print / render formats ---
*.stl  filter=lfs diff=lfs merge=lfs -text
*.STL  filter=lfs diff=lfs merge=lfs -text
*.obj  filter=lfs diff=lfs merge=lfs -text
*.3mf  filter=lfs diff=lfs merge=lfs -text

# --- Drawings / documents / images that tend to be large ---
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.PDF  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text

# Keep text files (README, this file, scripts) as normal git-diffable text
*.md   text
*.txt  text
.gitattributes text
.gitignore     text
